<Window x:Class="BlockLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BlockLauncher"
        Title="Hearth" Icon="hearth.ico" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Height="780" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/assets/hero.jpg" Stretch="UniformToFill"/>
    </Window.Background>

    <Window.Resources>
        <!-- 美化滚动条 -->
        <Style x:Key="SlimScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#55FFFFFF" CornerRadius="3" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}"/>
        <!-- 玻璃板样式 -->
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="#59101820"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#40101820"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="42"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8F0FA"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="#40FFFFFF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#D6E2F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="#30FFFFFF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/><Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#F0F6FF"/>
            <Setter Property="Padding" Value="13,7"/><Setter Property="FontSize" Value="11.5"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="#4DFFFFFF"/>
                    <Setter TargetName="b" Property="BorderBrush" Value="#AAFFFFFF"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <!-- 整体压暗（更轻，让背景更通透） -->
    <Grid Background="#66060A10">
        <!-- 主题色叠加层 -->
        <Rectangle x:Name="ThemeTint" Grid.RowSpan="10" Fill="#00000000" Opacity="0.05" IsHitTestVisible="False"/>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- 顶部玻璃条 -->
            <Border Grid.Row="0" Style="{StaticResource GlassPanel}" CornerRadius="10" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="14,0">
                    <StackPanel x:Name="TitleBarContent" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleLabel" Text="Hearth" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—" Style="{StaticResource WinBtn}" Click="Min_Click"/>
                        <Button Content="□" Style="{StaticResource WinBtn}" Click="Max_Click"/>
                        <Button Content="✕" Style="{StaticResource WinBtn}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 中间三块玻璃板 -->
            <Grid Grid.Row="1" Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavColumn" Width="176"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="DetailColumn" Width="278"/>
                </Grid.ColumnDefinitions>

                <!-- 左：导航玻璃板 -->
                <Border x:Name="NavPanel" Grid.Column="0" Style="{StaticResource GlassPanel}" Margin="0,0,10,0">
                    <DockPanel Margin="8,10">
                        <StackPanel DockPanel.Dock="Top">
                            <!-- 账户区（未登录 / 已登录） -->
                            <Border x:Name="AccountBox" Height="62" CornerRadius="9" Margin="3,0,3,10"
                                    Background="#33FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonUp="Account_Click">
                                <Grid Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="9" Background="#4D3B82F6" VerticalAlignment="Center" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock x:Name="AvatarText" Text="?" FontSize="15" FontWeight="Bold"
                                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock x:Name="AccountName" Text="未登录" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="AccountHint" Text="点击登录微软账号" FontSize="9" Foreground="#A9BCCF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Button x:Name="NavHome" Content="⌂   首页" Style="{StaticResource NavBtn}" Background="#4D3B82F6" Foreground="#FFFFFF" Click="NavHome_Click"/>
                            <Button x:Name="NavVersions" Content="▦   版本选择" Style="{StaticResource NavBtn}" Click="NavVersions_Click"/>
                            <Button x:Name="NavDownload" Content="↓   下载" Style="{StaticResource NavBtn}" Click="NavDownload_Click"/>

                            <Rectangle Height="1" Fill="#33FFFFFF" Margin="6,10"/>
                            <Button x:Name="NavSettings" Content="⚙   设置" Style="{StaticResource NavBtn}" Click="NavSettings_Click" Tag="设置"/>
                            <Button Content="?   帮助" Style="{StaticResource NavBtn}" Click="Help_Click" Tag="帮助"/>
                        </StackPanel>
                        <Grid/>
                    </DockPanel>
                </Border>

                <!-- 中：实例列表（每行一块小玻璃板） -->
                <Grid Grid.Column="1" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 首页 -->
                    <Grid x:Name="HomeView" Grid.Row="1">
                        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Canvas x:Name="HomeCanvas" Width="1150" Height="670">

                                <!-- 标题（用 Border 包，可缩放） -->
                                <Border x:Name="TitleBox" Canvas.Left="14" Canvas.Top="22" Width="191" Height="84"
                                        CornerRadius="8" Background="Transparent">
                                    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock x:Name="TitleText" Text="欢迎回来" FontSize="24" FontWeight="Bold">
                                                <TextBlock.Foreground>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#EAF2FF" Offset="0"/>
                                                        <GradientStop Color="#79B8FF" Offset="0.55"/>
                                                        <GradientStop Color="#4ADE80" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock Text="今天想玩点什么？" FontSize="11" Foreground="#C8D6E6" Margin="1,5,0,0"/>
                                        </StackPanel>
                                    </Viewbox>
                                </Border>

                                <!-- 你知道吗 -->
                                <Border x:Name="QuoteBox" Canvas.Left="223" Canvas.Top="84" Width="665" Height="40"
                                        CornerRadius="8" Background="#33101720" BorderBrush="#26FFFFFF" BorderThickness="1"
                                        Cursor="Hand" MouseLeftButtonUp="QuoteBox_Click" ToolTip="点一下换一条">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#4D203A5A"/>
                                                    <Setter Property="BorderBrush" Value="#5599C2FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="12,0">
                                        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="你知道吗？" FontSize="9" Foreground="#6B7C92"/>
                                                <TextBlock x:Name="QuoteText" Text="苦力怕原本是猪的模型做坏了的产物。"
                                                           FontSize="10.5" Foreground="#C8D6E6" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                                            </StackPanel>
                                        </Viewbox>
                                    </Grid>
                                </Border>

                                <!-- 推荐区 -->
                                <Border x:Name="RecBox" Canvas.Left="223" Canvas.Top="132" Width="665" Height="428"
                                        Style="{StaticResource GlassCard}">
                                    <Grid Margin="16,13">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="推荐" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="每日更新" FontSize="9" Foreground="#8FA0B8" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <UniformGrid x:Name="ModGrid" Grid.Row="1" Columns="2" VerticalAlignment="Stretch" Margin="0,10,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- 登录 -->
                                <Border x:Name="AccountBox2" Canvas.Left="14" Canvas.Top="565" Width="153" Height="50"
                                        CornerRadius="10" Background="#33101720" BorderBrush="#40FFFFFF" BorderThickness="1"
                                        Cursor="Hand" MouseLeftButtonUp="Account_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#55204A7A"/>
                                                    <Setter Property="BorderBrush" Value="#9959A8FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 头像 / 微软图标 -->
                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#CC1A2433"
                                                    BorderBrush="#40FFFFFF" BorderThickness="1" ClipToBounds="True">
                                                <!-- 微软四色块 / 真实皮肤头像 -->
                                                <Grid>
                                                    <Image x:Name="AvatarImage2" Stretch="UniformToFill" Visibility="Collapsed"/>
                                                    <Grid x:Name="MsLogo2" Width="12" Height="12">
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                        <Rectangle Grid.Row="0" Grid.Column="0" Fill="#F25022" Margin="0.5"/>
                                                        <Rectangle Grid.Row="0" Grid.Column="1" Fill="#7FBA00" Margin="0.5"/>
                                                        <Rectangle Grid.Row="1" Grid.Column="0" Fill="#00A4EF" Margin="0.5"/>
                                                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="#FFB900" Margin="0.5"/>
                                                    </Grid>
                                                    <TextBlock x:Name="AvatarText2" Text="" FontSize="12" FontWeight="Bold"
                                                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="Collapsed"/>
                                                </Grid>
                                            </Border>
                                            <!-- 文字 -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock x:Name="AccountName2" Text="未登录" FontSize="10.5"
                                                           FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock x:Name="AccountHint2" Text="点击登录微软账号" FontSize="8"
                                                           Foreground="#8FA8C4" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <!-- 箭头 -->
                                            <TextBlock Grid.Column="2" Text="›" FontSize="13" Foreground="#7A8BA8"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Viewbox>
                                </Border>

                                <!-- Let's Go -->
                                <Border x:Name="GoBox" Canvas.Left="14" Canvas.Top="620" Width="176" Height="44" CornerRadius="9">
                                    <Button Content="Let's Go" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="StartGame_Click"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <Button.Template><ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="#DD22C55E" CornerRadius="9">
                                                <Border.Effect>
                                                    <DropShadowEffect x:Name="GoGlow" Color="#22C55E" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#F22ED46A"/></Trigger></ControlTemplate.Triggers>
                                        </ControlTemplate></Button.Template>
                                    </Button>
                                </Border>

                                <!-- 右侧栏 -->
                                <Border x:Name="SidePanel" Canvas.Left="915" Canvas.Top="22" Width="221" Height="642"
                                        Style="{StaticResource GlassPanel}" Padding="12,12">
                                    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                    <StackPanel Width="197">
                                        <TextBlock Text="上次游玩" FontSize="9.5" Foreground="#B9C9DC" Margin="0,0,0,6"/>
                                        <Border Style="{StaticResource GlassCard}" Padding="11,10">
                                            <StackPanel>
                                                <TextBlock Text="1.21.4" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="原版 · Java 21" FontSize="9" Foreground="#B9C9DC" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="历史游玩" FontSize="9.5" Foreground="#B9C9DC" Margin="0,14,0,6"/>
                                        <StackPanel x:Name="HistoryList"/>
                                    </StackPanel>
                                    </Viewbox>
                                </Border>
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <!-- 版本选择：只放已经装好的版本 -->
                    <Grid x:Name="VersionsView" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="FolderBtn" Content="📁 默认 ▾" Click="FolderBtn_Click"
                                        Style="{StaticResource Ghost}" FontSize="10.5" Padding="9,4" Margin="0,0,10,0"
                                        Background="#33101720" BorderBrush="#40FFFFFF" Foreground="#E8F0FA"
                                        FocusVisualStyle="{x:Null}"
                                        ToolTip="切换游戏文件夹"/>
                                <TextBlock Text="版本选择" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="VersionCount" Text="" FontSize="10" Foreground="#B9C9DC" Margin="8,2,0,0"/>
                            </StackPanel>
                            <Button Content="＋ 新建" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource Ghost}" FontSize="10.5" Padding="11,5"
                                    Background="#CC2563EB" BorderBrush="#66A5D0FF"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                                <StackPanel x:Name="InstalledList"/>
                            </ScrollViewer>
                            <StackPanel x:Name="EmptyInstalled" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="还没有安装任何版本" FontSize="13" Foreground="#B9C9DC" HorizontalAlignment="Center"/>
                                <TextBlock Text="去「下载版本」挑一个装好，就能在这里启动" FontSize="10"
                                           Foreground="#6B7C92" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                <Button Content="去下载版本" Click="GoDownload_Click" Margin="0,14,0,0" Padding="14,6"
                                        FontSize="11" Cursor="Hand" Background="#CC2563EB" BorderBrush="#66A5D0FF" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 下载：版本下载 + 资源中心 -->
                    <Grid x:Name="DownloadView" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="下载" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="DownloadCount" Text="加载中…" FontSize="10" Foreground="#B9C9DC" Margin="8,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="导入整合包" Click="ImportPack_Click"
                                        Style="{StaticResource Ghost}" FontSize="10.5" Padding="11,5" Margin="0,0,6,0"/>
                                <Button Content="↻ 刷新" Click="RefreshDownload_Click"
                                        Style="{StaticResource Ghost}" FontSize="10.5" Padding="11,5"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,2">
                            <Button x:Name="TabVersions" Content="版本下载" Tag="versions" Click="DownloadTab_Click"
                                    FontSize="11" Padding="14,5" Margin="0,0,4,0" Cursor="Hand"/>
                            <Button x:Name="TabResources" Content="资源中心" Tag="resources" Click="DownloadTab_Click"
                                    FontSize="11" Padding="14,5" Cursor="Hand"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid x:Name="VersionsTabContent">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                                    <StackPanel x:Name="DownloadList"/>
                                </ScrollViewer>
                            </Grid>

                            <Grid x:Name="ResourcesTabContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ResourceQuery" Grid.Column="0" Height="32" FontSize="11.5"
                                             VerticalContentAlignment="Center" Padding="8,0"
                                             Background="#4DFFFFFF" Foreground="#FFFFFF" BorderBrush="#55FFFFFF"
                                             ToolTip="搜索名称，比如 sodium"/>
                                    <TextBox x:Name="ResourceVersion" Grid.Column="1" Width="110" Height="32" FontSize="11"
                                             Margin="8,0,0,0" VerticalContentAlignment="Center" Padding="8,0"
                                             Background="#4DFFFFFF" Foreground="#FFFFFF" BorderBrush="#55FFFFFF"
                                             ToolTip="游戏版本，留空不限"/>
                                    <Button x:Name="ResourceSearchBtn" Grid.Column="2" Content="搜索" Width="72" Height="32"
                                            Margin="8,0,0,0" FontSize="11" Cursor="Hand"
                                            Background="#CC2563EB" BorderBrush="#66A5D0FF" Foreground="#FFFFFF"
                                            Click="ResourceSearch_Click"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ResAll" Content="全部" Click="ResourceType_Click" Tag="all" Style="{StaticResource Ghost}" FontSize="10" Padding="10,4" Margin="0,0,4,0" Cursor="Hand"/>
                                    <Button x:Name="ResMod" Content="Mod" Click="ResourceType_Click" Tag="mod" Style="{StaticResource Ghost}" FontSize="10" Padding="10,4" Margin="0,0,4,0" Cursor="Hand"/>
                                    <Button x:Name="ResPack" Content="资源包" Click="ResourceType_Click" Tag="resourcepack" Style="{StaticResource Ghost}" FontSize="10" Padding="10,4" Margin="0,0,4,0" Cursor="Hand"/>
                                    <Button x:Name="ResShader" Content="光影" Click="ResourceType_Click" Tag="shader" Style="{StaticResource Ghost}" FontSize="10" Padding="10,4" Margin="0,0,4,0" Cursor="Hand"/>
                                    <Button x:Name="ResData" Content="数据包" Click="ResourceType_Click" Tag="datapack" Style="{StaticResource Ghost}" FontSize="10" Padding="10,4" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                            <StackPanel x:Name="ResourceList"/>
                        </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 设置页 -->
                    <local:SettingsView x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed"/>

                    <!-- 下载小球（界面内右下角，下载期间一直在） -->
                    <Border x:Name="DownloadBall" Grid.Row="1" Width="64" Height="64" CornerRadius="32" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22"
                            Background="#F00C1118" BorderBrush="#55FFFFFF" BorderThickness="1"
                            Cursor="Hand" MouseLeftButtonUp="DownloadBall_Click"
                            ToolTip="点一下看下载详情">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55"/>
                        </Border.Effect>
                        <Grid>
                            <Ellipse x:Name="BallRing" Width="50" Height="50" Stroke="#26FFFFFF" StrokeThickness="3"/>
                            <Ellipse x:Name="BallSpinner" Width="50" Height="50" Stroke="#FF66C8FF" StrokeThickness="3"
                                     StrokeDashArray="16 14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="BallSpin" Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <TextBlock x:Name="BallPct" Text="0%" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 右：详情/上次游玩 -->
                <Border Grid.Column="2" Style="{StaticResource GlassPanel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <Grid>
                        <!-- 首页模式：上次游玩 -->
                        <StackPanel x:Name="DetailHost" Margin="16,16" Visibility="Collapsed">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </StackPanel.RenderTransform>
                            <TextBlock x:Name="DetailName" Text="1.21.4 生存服" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="DetailSub" Text="Fabric 0.16.9 · 2 小时前" FontSize="10" Foreground="#B9C9DC" Margin="0,3,0,0"/>

                            <Button x:Name="LaunchBtn" Content="开 始 游 戏" Margin="0,14,0,0" Height="40" FontSize="13.5" FontWeight="Bold" Cursor="Hand" Click="Launch_Click">
                                <Button.Template><ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="#DD22C55E" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#F22ED46A"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate></Button.Template>
                            </Button>
                            <StackPanel x:Name="LaunchProgress" Visibility="Collapsed" Margin="0,10,0,0">
                                <Grid Height="4" Background="#33FFFFFF" ClipToBounds="True">
                                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" Background="#66C8FF" CornerRadius="2"/>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <TextBlock x:Name="ProgressText" Text="正在准备…" FontSize="9.5" Foreground="#B9C9DC"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="LaunchCancelBtn" Content="取消启动" HorizontalAlignment="Right"
                                            Visibility="Collapsed" FontSize="9.5" Padding="8,3" Cursor="Hand"
                                            Background="#33EF4444" BorderBrush="#66EF4444" BorderThickness="1"
                                            Foreground="#FFD6D6" Click="LaunchCancel_Click"/>
                                </Grid>
                            </StackPanel>

                            <UniformGrid Columns="2" Margin="0,7,0,0">
                                <Button Content="打开目录" Click="OpenVersionFolder_Click" Style="{StaticResource Ghost}" Margin="0,0,3,0" FontSize="10.5" Padding="8,6"/>
                                <Button Content="版本编辑" Click="EditVersion_Click" Style="{StaticResource Ghost}" Margin="3,0,0,0" FontSize="10.5" Padding="8,6"/>
                            </UniformGrid>

                            <Border Style="{StaticResource GlassCard}" Padding="12,10" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="运行参数" FontSize="10" Foreground="#B9C9DC" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="版本" FontSize="10.5" Foreground="#B9C9DC"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="1.21.4" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Grid.Row="1" Text="加载器" FontSize="10.5" Foreground="#B9C9DC" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="DetailLoader" Grid.Row="1" Grid.Column="1" Text="Fabric 0.16.9" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2" Text="内存" FontSize="10.5" Foreground="#B9C9DC" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="DetailMem" Grid.Row="2" Grid.Column="1" Text="4096 MB" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                      </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 底部玻璃条 -->
            <Border Grid.Row="2" Style="{StaticResource GlassPanel}" CornerRadius="8">
                <Grid Margin="13,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="4" Height="4" Fill="#4ADE80" Margin="0,0,6,0"/>
                        <TextBlock Text="就绪" FontSize="9.5" Foreground="#CFE0F2"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="UpdateBar" Visibility="Collapsed" CornerRadius="6" Padding="7,2"
                                Margin="0,0,10,0" Background="#332563EB" BorderBrush="#663B82F6"
                                BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="UpdateBar_Click">
                            <TextBlock x:Name="UpdateBarText" Text="有新版本" FontSize="9.5" Foreground="#9CC8FF"/>
                        </Border>
                        <TextBlock x:Name="StatusBarText" Text="就绪" FontSize="9.5" Foreground="#CFE0F2" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 启动画面：一开始盖住整个界面，加载完十字裂开露出主页 -->
        <Grid x:Name="SplashLayer" Panel.ZIndex="999" Background="#F00A0F16">
            <Image x:Name="SplashBg" Stretch="UniformToFill" Opacity="0.28"/>
            <Rectangle Fill="#E60A0F16"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border x:Name="SplashIconBox" Width="96" Height="96" CornerRadius="22"
                        HorizontalAlignment="Center" Background="#33101720"
                        BorderBrush="#55FFFFFF" BorderThickness="1">
                    <Image x:Name="SplashIcon" Stretch="Uniform" Margin="2"/>
                </Border>
                <TextBlock Text="Hearth" FontSize="30" FontWeight="Bold" Foreground="#F2F7FF"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="炉火" FontSize="13" Foreground="#8FA8C4"
                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <Border Width="170" Height="3" CornerRadius="2" Background="#33FFFFFF"
                        Margin="0,24,0,0" ClipToBounds="True" HorizontalAlignment="Center">
                    <Border x:Name="SplashBar" Width="0" Height="3" CornerRadius="2"
                            HorizontalAlignment="Left" Background="#79B8FF"/>
                </Border>
                <TextBlock x:Name="SplashStatus" Text="正在准备…" FontSize="10.5" Foreground="#7A8BA8"
                           HorizontalAlignment="Center" Margin="0,11,0,0"/>
            </StackPanel>
            <Canvas x:Name="SplashShards" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>