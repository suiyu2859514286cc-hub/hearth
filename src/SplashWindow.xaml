<Window x:Class="BlockLauncher.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearth"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Opacity="0">

    <Grid x:Name="RootGrid">
        <!-- 全屏底：背景图 + 压暗 -->
        <Grid x:Name="Backdrop">
            <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="0.28"/>
            <Rectangle Fill="#E60A0F16"/>
        </Grid>

        <!-- 中央内容 -->
        <StackPanel x:Name="ContentPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border x:Name="IconBox" Width="96" Height="96" CornerRadius="22"
                    HorizontalAlignment="Center" Background="#33101720"
                    BorderBrush="#55FFFFFF" BorderThickness="1">
                <Image x:Name="IconImage" Stretch="Uniform" Margin="2"/>
            </Border>

            <TextBlock Text="Hearth" FontSize="30" FontWeight="Bold" Foreground="#F2F7FF"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock Text="炉火" FontSize="13" Foreground="#8FA8C4"
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>

            <Border Width="170" Height="3" CornerRadius="2" Background="#33FFFFFF"
                    Margin="0,24,0,0" ClipToBounds="True" HorizontalAlignment="Center">
                <Border x:Name="BarFill" Width="0" Height="3" CornerRadius="2"
                        HorizontalAlignment="Left" Background="#79B8FF"/>
            </Border>

            <TextBlock x:Name="StatusText" Text="正在准备…" FontSize="10.5" Foreground="#7A8BA8"
                       HorizontalAlignment="Center" Margin="0,11,0,0"/>
        </StackPanel>

        <!-- 裂开时用的四个碎片会加到这里 -->
        <Canvas x:Name="ShardLayer" Visibility="Collapsed"/>
    </Grid>
</Window>
