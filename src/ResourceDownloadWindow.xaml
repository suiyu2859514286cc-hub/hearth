<Window x:Class="BlockLauncher.ResourceDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载" Height="520" Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E8F0FA"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootPanel" Background="#F00C1118" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <Button Content="←" Width="32" Height="28" FontSize="15" Background="Transparent"
                            Foreground="#C8D6E6" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
                    <TextBlock x:Name="TitleText" Text="下载" FontSize="14" FontWeight="SemiBold"
                               Foreground="#FFFFFF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30"
                        FontSize="12" Background="Transparent" Foreground="#8B97AB" BorderThickness="0"
                        Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <!-- 详情卡 -->
            <Border Grid.Row="1" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                    CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="IconBox" Width="46" Height="46" CornerRadius="9" Background="#2A3A50"
                                VerticalAlignment="Top" ClipToBounds="True"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NameText" Text="" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="MetaText" Text="" FontSize="10" Foreground="#8FA0B8" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="DescText" Text="" FontSize="10.5" Foreground="#B9C9DC"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 下载位置 + 下载按钮（放顶部，保证一定能点到） -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="下载到" FontSize="10" Foreground="#8FA0B8" VerticalAlignment="Center" Margin="2,0,10,0"/>
                    <StackPanel x:Name="TargetPanel" Orientation="Horizontal"/>
                </StackPanel>
                <Button x:Name="DownloadBtn" Content="下载" Width="100" Height="32"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#CC2563EB" BorderBrush="#66A5D0FF" Foreground="#FFFFFF"
                        IsEnabled="False" Style="{StaticResource Btn}" Click="Download_Click"/>
            </Grid>

            <!-- 版本筛选 -->
            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Margin="0,10,0,8">
                <StackPanel x:Name="VersionFilter" Orientation="Horizontal"/>
            </ScrollViewer>

            <!-- 分组列表 -->
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel x:Name="GroupList"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
