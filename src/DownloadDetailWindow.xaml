<Window x:Class="BlockLauncher.DownloadDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载详情" Height="440" Width="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E8F0FA"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootPanel" Background="#F00C1118" BorderBrush="#3DFFFFFF" BorderThickness="1" CornerRadius="14">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="7" Background="#22FFFFFF" ClipToBounds="True">
                        <Image Source="/hearth.ico" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Text="下载详情" FontSize="14" FontWeight="SemiBold"
                               Foreground="#FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Width="30" Height="30" FontSize="12"
                        Background="Transparent" Foreground="#8B97AB" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,4,18,0">
                    <TextBlock Text="总进度" FontSize="10.5" Foreground="#8FA0B8"/>
                    <TextBlock x:Name="PctText" Text="0 %" FontSize="30" FontWeight="Bold" Foreground="#FFFFFF"/>

                    <Border Height="1" Background="#22FFFFFF" Margin="0,12"/>

                    <TextBlock Text="已用时间" FontSize="10.5" Foreground="#8FA0B8"/>
                    <TextBlock x:Name="TimeText" Text="0:00" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>

                    <Border Height="1" Background="#22FFFFFF" Margin="0,12"/>

                    <TextBlock Text="下载速度" FontSize="10.5" Foreground="#8FA0B8"/>
                    <TextBlock x:Name="SpeedText" Text="— " FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>

                    <Border Height="1" Background="#22FFFFFF" Margin="0,12"/>

                    <TextBlock Text="当前" FontSize="10.5" Foreground="#8FA0B8"/>
                    <TextBlock x:Name="StateText" Text="准备中…" FontSize="10.5" Foreground="#D6E2F0"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                        CornerRadius="10" Padding="16,12">
                    <StackPanel x:Name="StepList"/>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <TextBlock x:Name="HintText" Text="" FontSize="10" Foreground="#6B7C92" VerticalAlignment="Center"/>
                <Button x:Name="CancelBtn" Content="取消下载" Width="104" HorizontalAlignment="Right"
                        Style="{StaticResource Btn}" Click="Cancel_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
