<Window x:Class="BlockLauncher.ThirdPartyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="第三方账号登录" Height="420" Width="500"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">

    <Border x:Name="RootPanel" Background="#F0101720" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="第三方账号登录" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                <Button Content="✕" HorizontalAlignment="Right" Width="30" Height="30" FontSize="12"
                        Background="Transparent" Foreground="#8B97AB" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="用皮肤站的账号登录，登录后能显示站内皮肤、进支持皮肤站的服务器。"
                           FontSize="10.5" Foreground="#8FA8C4" TextWrapping="Wrap"/>

                <TextBlock Text="皮肤站" FontSize="10" Foreground="#B9C9DC" Margin="0,16,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="SiteCombo" Width="300" Height="32" FontSize="11"
                              SelectionChanged="Site_Changed"/>
                    <Button Content="自定义" Margin="8,0,0,0" Height="32" Padding="12,0" FontSize="10.5"
                            Cursor="Hand" Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                            Foreground="#D6E2F0" Click="CustomSite_Click"/>
                </StackPanel>

                <TextBox x:Name="CustomUrlBox" Height="32" FontSize="10.5" Margin="0,8,0,0"
                         Padding="8,0" VerticalContentAlignment="Center" Visibility="Collapsed"
                         Background="#33FFFFFF" Foreground="#FFFFFF" BorderBrush="#55FFFFFF"/>

                <TextBlock Text="邮箱 / 用户名" FontSize="10" Foreground="#B9C9DC" Margin="0,14,0,5"/>
                <TextBox x:Name="EmailBox" Height="32" FontSize="11" Padding="8,0"
                         VerticalContentAlignment="Center"
                         Background="#33FFFFFF" Foreground="#FFFFFF" BorderBrush="#55FFFFFF"/>

                <TextBlock Text="密码" FontSize="10" Foreground="#B9C9DC" Margin="0,12,0,5"/>
                <PasswordBox x:Name="PasswordBox" Height="32" FontSize="11" Padding="8,0"
                             VerticalContentAlignment="Center"
                             Background="#33FFFFFF" Foreground="#FFFFFF" BorderBrush="#55FFFFFF"/>

                <TextBlock x:Name="StatusText" Text="" FontSize="10" Foreground="#F87171"
                           Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="账号只存在本机，不会上传" FontSize="9" Foreground="#6B7789"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Width="88" Height="32" FontSize="10.5" Cursor="Hand"
                            Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                            Foreground="#D6E2F0" Margin="0,0,10,0" Click="Close_Click"/>
                    <Button x:Name="LoginBtn" Content="登录" Width="110" Height="32" FontSize="10.5"
                            FontWeight="SemiBold" Cursor="Hand" Background="#CC2563EB" BorderThickness="0"
                            Foreground="#FFFFFF" Click="Login_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
