<Window x:Class="BlockLauncher.CapePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择披风" Height="520" Width="580"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True" WindowStartupLocation="Manual">

    <Border x:Name="RootPanel" Background="#F00C1118" BorderBrush="#3DFFFFFF" BorderThickness="1" CornerRadius="14">
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="选择披风" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" Width="30" Height="30" FontSize="12"
                        Background="Transparent" Foreground="#8B97AB" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <WrapPanel x:Name="CapeGrid"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="取消" Width="90" Padding="0,8" FontSize="11" Cursor="Hand"
                        Background="#22FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1"
                        Foreground="#E8F0FA" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
