<Window x:Class="BlockLauncher.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入整合包" Height="470" Width="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="0,9"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootPanel" Background="#F0101720" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="导入整合包" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StartBtn" Content="开始导入" Width="110" Margin="0,0,8,0"
                            Background="#CC2563EB" BorderBrush="#66A5D0FF" Foreground="#FFFFFF"
                            IsEnabled="False" Style="{StaticResource Btn}" Click="Start_Click"/>
                    <Button Content="✕" Width="30" Height="30" FontSize="12"
                            Background="Transparent" Foreground="#8B97AB" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="选择压缩包" Width="130" Style="{StaticResource Btn}" Click="PickZip_Click"/>
                    <Button Content="选择文件夹" Width="130" Margin="10,0,0,0" Style="{StaticResource Btn}" Click="PickFolder_Click"/>
                </StackPanel>

                <TextBlock Text="支持 CurseForge / Modrinth 整合包，以及整个 .minecraft 文件夹"
                           FontSize="9.5" Foreground="#6B7C92" Margin="2,10,0,0"/>

                <Border Background="#33FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="9"
                        Padding="14,12" Margin="0,14,0,0" MinHeight="80">
                    <StackPanel>
                        <TextBlock x:Name="PackName" Text="还没有选择文件" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#EAF2FF"/>
                        <TextBlock x:Name="PackDetail" Text="" FontSize="10.5" Foreground="#9DB0C6"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="NameRow" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="整合包名字" FontSize="11" Foreground="#B9C9DC" VerticalAlignment="Center"
                               Margin="2,0,10,0"/>
                    <TextBox x:Name="NameBox" Width="320" Height="30" FontSize="11.5"
                             VerticalContentAlignment="Center" Padding="8,0"
                             Background="#33FFFFFF" Foreground="#FFFFFF" BorderBrush="#33FFFFFF"/>
                </StackPanel>

                <ProgressBar x:Name="Bar" Height="7" Minimum="0" Maximum="100" Value="0" Margin="0,16,0,0"
                             Background="#33FFFFFF" Foreground="#66C8FF" BorderThickness="0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3.5" ClipToBounds="True">
                                <Grid>
                                    <Rectangle x:Name="PART_Track"/>
                                    <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                               Fill="{TemplateBinding Foreground}" RadiusX="3.5" RadiusY="3.5"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>

                <TextBlock x:Name="StatusText" Text="" FontSize="10.5" Foreground="#A9BCCF" Margin="0,9,0,0"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Button x:Name="CancelBtn" Content="关闭" Width="100" HorizontalAlignment="Left"
                        Style="{StaticResource Btn}" Click="Close_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
