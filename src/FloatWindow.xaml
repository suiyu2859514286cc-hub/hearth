<Window x:Class="BlockLauncher.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载" Width="368" Height="168"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True" Topmost="True">

    <Border x:Name="RootPanel" Background="#F20C1118" BorderBrush="#3DFFFFFF" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 图标 + 标题 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="8" Background="#22FFFFFF" ClipToBounds="True">
                    <Image Source="/hearth.ico" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="TitleText" Text="安装中" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="StageText" Text="准备中…" FontSize="9.5" Foreground="#8FA0B8"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Width="26" Height="26" FontSize="11"
                        Background="Transparent" Foreground="#8B97AB" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>

            <!-- 进度 -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0">
                <Border Height="6" CornerRadius="3" Background="#26FFFFFF" ClipToBounds="True">
                    <Grid>
                        <Rectangle x:Name="Fill" Width="0" HorizontalAlignment="Left"
                                   Fill="#FF66C8FF" RadiusX="3" RadiusY="3"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 底部数字 -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <TextBlock x:Name="PctText" Text="0 %" FontSize="10" Foreground="#FFFFFF"/>
                <TextBlock x:Name="InfoText" Text="" FontSize="9.5" Foreground="#6B7C92"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
