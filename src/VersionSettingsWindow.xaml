<Window x:Class="BlockLauncher.VersionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本设置" Height="620" Width="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E8F0FA"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C8D6E6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,10"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootPanel" Background="#F00C1118" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="20,0,14,0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="←" Width="34" Height="30" FontSize="16" Background="Transparent"
                            Foreground="#C8D6E6" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
                    <TextBlock x:Name="TitleText" Text="版本设置" FontSize="14" FontWeight="SemiBold"
                               Foreground="#FFFFFF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Width="30" Height="30" FontSize="12"
                        Background="Transparent" Foreground="#8B97AB" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="10,4,0,10">
                    <Button x:Name="NavOverview" Content="概览" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="overview"/>
                    <Button x:Name="NavSettings" Content="设置" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="settings"/>
                    <Button x:Name="NavModify" Content="修改" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="modify"/>
                    <Button x:Name="NavMods" Content="Mod 管理" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="mods"/>
                    <Button x:Name="NavExport" Content="导出" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="export"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,0"
                        CornerRadius="10" Margin="0,0,12,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,16">
                        <StackPanel x:Name="PageHost"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
