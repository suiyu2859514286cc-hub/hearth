<UserControl x:Class="BlockLauncher.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E8F0FA"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C8D6E6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,9"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,4,8,0">
            <Button x:Name="NavLaunch" Content="启动" Style="{StaticResource NavItem}" Tag="launch" Click="Nav_Click"/>
            <Button x:Name="NavUI" Content="个性化" Style="{StaticResource NavItem}" Tag="ui" Click="Nav_Click"/>
            <!-- 联机入口暂时隐藏：试过樱花穿透，节点连不上，先让用户用樱花桌面端。
                 代码保留在 NatFrpService.cs / ShowNet()，以后要恢复把 Visibility 去掉即可。 -->
            <Button x:Name="NavNet" Content="联机" Style="{StaticResource NavItem}" Tag="net" Click="Nav_Click" Visibility="Collapsed"/>
            <Button x:Name="NavOther" Content="其他" Style="{StaticResource NavItem}" Tag="other" Click="Nav_Click"/>
        </StackPanel>

        <Border Grid.Column="1" Background="#E60B1119" BorderBrush="#26FFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="16,12" Margin="0,0,4,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel x:Name="PageHost"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
