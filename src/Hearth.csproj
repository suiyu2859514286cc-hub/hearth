<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Hearth</AssemblyName>
    <RootNamespace>BlockLauncher</RootNamespace>
    <ApplicationIcon>hearth.ico</ApplicationIcon>
    <Product>Hearth</Product>
    <AssemblyTitle>Hearth</AssemblyTitle>
    <Company>Hearth</Company>
    <Version>0.4.2</Version>
    <FileVersion>0.4.2.0</FileVersion>
    <InformationalVersion>0.4.2-beta</InformationalVersion>

    <!-- 发布成单文件 exe，直接放根目录双击就能用 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 自带运行时：拷到没装 .NET 的电脑也能直接双击 -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- 背景图直接编进 exe，不依赖外部 assets 文件夹 -->
    <Resource Include="..\assets\*.*" Link="assets\%(Filename)%(Extension)" />
    <!-- 启动画面用的壁炉图标 -->
    <Resource Include="splash-icon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="hearth.ico" />
  </ItemGroup>
</Project>