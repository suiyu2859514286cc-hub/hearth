<Window x:Class="BlockLauncher.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录微软账号" Height="440" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="LoginBtn" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="0,9"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootPanel" Background="#F0101720" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="登录微软账号" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" Width="30" Height="30" FontSize="12"
                        Background="Transparent" Foreground="#8B97AB" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,14">
                <TextBlock Text="请打开下面的网址，输入验证码并登录" FontSize="11.5" Foreground="#B9C9DC" HorizontalAlignment="Center"/>

                <Border Background="#33FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="10"
                        Padding="20,16" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <TextBlock x:Name="CodeText" Text="--------" FontSize="30" FontWeight="Bold"
                               Foreground="#FFFFFF" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="UrlText" Text="https://microsoft.com/link" FontSize="12"
                           Foreground="#79A9FF" HorizontalAlignment="Center" Margin="0,14,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Content="复制验证码" Style="{StaticResource LoginBtn}" Width="110" Click="Copy_Click"/>
                    <Button Content="打开网页" Style="{StaticResource LoginBtn}" Width="110" Margin="10,0,0,0" Click="OpenUrl_Click"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Text="正在获取验证码…" FontSize="11" Foreground="#A9BCCF" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <Grid>
                    <TextBlock x:Name="FooterHint" Text="登录成功后可游玩正版服务器" FontSize="9.5"
                               Foreground="#6B7789" VerticalAlignment="Center"/>
                    <Button x:Name="OfflineEntry" Content="没有正版账号？用离线登录 ›"
                            HorizontalAlignment="Right" FontSize="9.5" Padding="0" BorderThickness="0"
                            Background="Transparent" Foreground="#7A9BC8" Cursor="Hand"
                            Click="OfflineEntry_Click"/>
                </Grid>

                <!-- 离线登录面板 -->
                <StackPanel x:Name="OfflinePanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="离线模式：只改游戏里显示的名字，不能进正版服务器"
                               FontSize="9.5" Foreground="#8FA8C4" TextWrapping="Wrap"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OfflineNameBox" Grid.Column="0" Height="34" FontSize="12"
                                 Padding="10,0" VerticalContentAlignment="Center"
                                 Background="#33FFFFFF" Foreground="#FFFFFF" BorderBrush="#55FFFFFF"
                                 MaxLength="16" ToolTip="{x:Null}"/>
                        <Button Grid.Column="1" Content="用这个名字进游戏" Margin="8,0,0,0" Height="34"
                                Padding="12,0" FontSize="10.5" Cursor="Hand"
                                Background="#CC2563EB" BorderThickness="0" Foreground="#FFFFFF"
                                Click="OfflineConfirm_Click"/>
                        <Button Grid.Column="2" Content="取消" Margin="8,0,0,0" Height="34"
                                Padding="12,0" FontSize="10.5" Cursor="Hand"
                                Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                Foreground="#D6E2F0" Click="OfflineCancel_Click"/>
                    </Grid>
                    <TextBlock x:Name="OfflineStatus" Text="" FontSize="9.5" Foreground="#F87171"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>