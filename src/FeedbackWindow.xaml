<Window x:Class="BlockLauncher.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发个反馈" Height="400" Width="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E8F0FA"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootPanel" Background="#F00C1118" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="发个反馈" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SendBtn" Content="发送" Width="92" Margin="0,0,8,0"
                            Background="#CC2563EB" BorderBrush="#66A5D0FF" Foreground="#FFFFFF"
                            Style="{StaticResource Btn}" Click="Send_Click"/>
                    <Button Content="✕" Width="30" Height="30" FontSize="12"
                            Background="Transparent" Foreground="#8B97AB" BorderThickness="0" Cursor="Hand"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock Text="哪里不对劲、想加点什么，随便写。" FontSize="10.5" Foreground="#8FA0B8"/>
                <Grid Margin="0,10,0,0">
                    <TextBox x:Name="ContentBox" FontSize="11.5" Padding="10,8"
                             Background="#22FFFFFF" Foreground="#FFFFFF" BorderBrush="#44FFFFFF"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Height="210" VerticalContentAlignment="Top"
                             TextChanged="ContentBox_TextChanged"/>
                    <TextBlock x:Name="Placeholder"
                               Text="这里貌似有一本上古秘籍，好像是上.......BA。"
                               IsHitTestVisible="False" Margin="13,10,13,0"
                               VerticalAlignment="Top" FontSize="11.5" Foreground="#5A6B82"
                               TextWrapping="Wrap"/>
                </Grid>
                <TextBlock x:Name="StatusText" Text="" FontSize="10" Foreground="#8FA0B8" Margin="0,8,0,0"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Button Content="关闭" Width="96" HorizontalAlignment="Left"
                        Style="{StaticResource Btn}" Click="Close_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
