<Window x:Class="BlockLauncher.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装版本" Height="500" Width="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="0,9"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootPanel" Background="#F0101720" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="24">

            <!-- 第一步：选组件（照 PCL 的安装页） -->
            <Grid x:Name="SelectView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="安装新版本" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="StartBtn" Content="开始安装" Width="104" Margin="0,0,8,0"
                                Background="#CC22C55E" BorderBrush="#66A5FFB8" Foreground="#FFFFFF"
                                Style="{StaticResource Btn}" Click="Start_Click"/>
                        <Button Content="✕" Width="30" Height="30" FontSize="12"
                                Background="Transparent" Foreground="#8B97AB" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#33FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                        CornerRadius="9" Padding="14,11" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="7" Background="#3D6B4A">
                            <TextBlock Text="🟩" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="VersionText" Text="1.21.4" FontSize="18" FontWeight="Bold"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <TextBlock x:Name="VersionTypeText" Text="" FontSize="10" Foreground="#8FA0B8"
                                   VerticalAlignment="Center" Margin="10,4,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <StackPanel x:Name="LoaderListPanel">
                        <StackPanel x:Name="LoaderList"/>
                        <CheckBox x:Name="AssetsCheck" Content="下载资源文件（贴图 / 音效）" IsChecked="True"
                                  Foreground="#D6E2F0" FontSize="11" Cursor="Hand" Margin="2,10,0,0"/>
                        <TextBlock x:Name="HintText" Text="加载器可以之后再加，先装原版也没问题" FontSize="9.5"
                                   Foreground="#6B7C92" Margin="2,8,0,0"/>
                    </StackPanel>

                    <Grid x:Name="PickerPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                            <Button Content="← 返回" Width="76" Style="{StaticResource Btn}" Click="BackToLoaders_Click"/>
                            <TextBlock x:Name="PickerTitle" Text="版本" FontSize="12.5" Foreground="#D6E2F0"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="250">
                            <StackPanel x:Name="PickerList"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>


            </Grid>

            <!-- 第二步：下载进度 -->
            <Grid x:Name="ProgressView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock x:Name="TitleText" Text="安装" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" Width="30" Height="30" FontSize="12"
                            Background="Transparent" Foreground="#8B97AB" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：总进度 / 速度 / 剩余 -->
                    <StackPanel Grid.Column="0" Margin="0,2,16,0">
                        <TextBlock Text="总进度" FontSize="10.5" Foreground="#8FA0B8"/>
                        <TextBlock x:Name="PctText" Text="0 %" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Border Height="1" Background="#22FFFFFF" Margin="0,12"/>
                        <TextBlock Text="下载速度" FontSize="10.5" Foreground="#8FA0B8"/>
                        <TextBlock x:Name="SpeedText" Text="0 B/s" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <Border Height="1" Background="#22FFFFFF" Margin="0,12"/>
                        <TextBlock Text="剩余文件" FontSize="10.5" Foreground="#8FA0B8"/>
                        <TextBlock x:Name="RemainText" Text="0" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="StatusText" Text="准备中…" FontSize="9.5" Foreground="#6B7C92"
                                   TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>

                    <!-- 右：任务清单 -->
                    <Border Grid.Column="1" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                            CornerRadius="10" Padding="14,10">
                        <StackPanel x:Name="StepList"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Button x:Name="CancelBtn" Content="取消" Width="100" HorizontalAlignment="Left"
                            Style="{StaticResource Btn}" Click="Cancel_Click"/>
                    <Button x:Name="DoneBtn" Content="完成" Width="100" HorizontalAlignment="Right"
                            Style="{StaticResource Btn}" Visibility="Collapsed" Click="Close_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
